# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/school_management

# Server Configuration
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# JWT Secret
JWT_SECRET=your-secret-key-change-this-in-production

# LiveKit Configuration — create a free project at https://cloud.livekit.io
# and copy its WS URL + API key/secret here. (Self-hosting LiveKit yourself
# is also possible but not recommended on a host like Render that doesn't
# support long-lived UDP-heavy media servers well.)
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_HTTP_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Email Configuration (for contact form)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
SCHOOL_EMAIL=school@lycee-obessa.com

# Groq API (for AI chat)
GROQ_API_KEY=your-groq-api-key